# Banco de dados
# Padrão: SQLite local (nenhuma configuração necessária).
# Para usar Postgres, descomente e ajuste a linha abaixo:
# DATABASE_URL=postgresql+psycopg2://realestate_user:realestate_pass@localhost:5432/realestate_db

# Fonte de dados padrão: "demo" (sintética, sempre funciona) ou "live" (scraping real)
DATA_SOURCE=demo

# API Keys (opcional)
GOOGLE_PLACES_API_KEY=

# Scraping
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
SCRAPE_TIMEOUT=15
SCRAPE_MAX_RETRIES=2

# Streamlit
STREAMLIT_THEME=dark
STREAMLIT_SERVER_PORT=8501

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Cache (opcional). Deixe em branco para usar cache em memória.
REDIS_URL=
USE_REDIS=false
